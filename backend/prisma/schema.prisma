model WhatsappSettings {
  id               String   @id @default(uuid())
  isEnabled        Boolean  @default(false) @map("is_enabled")
  twilioAccountSid String?  @map("twilio_account_sid")
  twilioAuthToken  String?  @map("twilio_auth_token")
  whatsappFrom     String?  @map("whatsapp_from")
  mediaUrl         String?  @map("media_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_settings")
}

// ─────────────────────────────────────────────
// EMAIL SETTINGS
// ─────────────────────────────────────────────

model EmailSettings {
  id                  String   @id @default(uuid())
  smtpHost            String?  @map("smtp_host")
  smtpPort            Int      @default(587) @map("smtp_port")
  smtpSecure          Boolean  @default(false) @map("smtp_secure")
  smtpUser            String?  @map("smtp_user")
  smtpPass            String?  @map("smtp_pass")
  fromAddress         String   @default("noreply@itour.local") @map("from_address")
  notifyDispatchEmail String?  @map("notify_dispatch_email")
  notifyTrafficEmail  String?  @map("notify_traffic_email")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("email_settings")
}

// ─────────────────────────────────────────────
// WHATSAPP NOTIFICATION LOG
// ─────────────────────────────────────────────

enum WhatsappNotificationStatus {
  SENT
  FAILED
}

model WhatsappNotificationLog {
  id             String                     @id @default(uuid())
  trafficJobId   String                     @map("traffic_job_id")
  recipientPhone String                     @map("recipient_phone")
  templateId     String?                    @map("template_id")
  templateName   String?                    @map("template_name")
  messageSid     String?                    @map("message_sid")
  status         WhatsappNotificationStatus
  errorMessage   String?                    @map("error_message")
  sentAt         DateTime                   @default(now()) @map("sent_at")

  trafficJob TrafficJob        @relation(fields: [trafficJobId], references: [id])
  template   WhatsappTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([trafficJobId, recipientPhone, templateId])
  @@map("whatsapp_notification_logs")
}

// ─────────────────────────────────────────────
// ROLE PERMISSIONS
// ─────────────────────────────────────────────

model RolePermission {
  id        String   @id @default(uuid())
  role      UserRole
  module    String
  canView   Boolean  @default(false) @map("can_view")
  canCreate Boolean  @default(false) @map("can_create")
  canEdit   Boolean  @default(false) @map("can_edit")
  canDelete Boolean  @default(false) @map("can_delete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([role, module])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// REP NOTIFICATIONS
// ─────────────────────────────────────────────

model RepNotification {
  id            String           @id @default(uuid())
  repId         String           @map("rep_id")
  title         String
  message       String
  type          NotificationType @default(GENERAL)
  isRead        Boolean          @default(false) @map("is_read")
  trafficJobId  String?          @map("traffic_job_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  rep           Rep              @relation(fields: [repId], references: [id])
  trafficJob    TrafficJob?      @relation(fields: [trafficJobId], references: [id])

  @@map("rep_notifications")
}

// ─────────────────────────────────────────────
// DRIVER NOTIFICATIONS
// ─────────────────────────────────────────────

model DriverNotification {
  id            String           @id @default(uuid())
  driverId      String           @map("driver_id")
  title         String
  message       String
  type          NotificationType @default(GENERAL)
  isRead        Boolean          @default(false) @map("is_read")
  trafficJobId  String?          @map("traffic_job_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  driver        Driver           @relation(fields: [driverId], references: [id])
  trafficJob    TrafficJob?      @relation(fields: [trafficJobId], references: [id])

  @@map("driver_notifications")
}

// ─────────────────────────────────────────────
// USER NOTIFICATIONS (dashboard users)
// ─────────────────────────────────────────────

model UserNotification {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  title         String
  message       String
  type          NotificationType @default(GENERAL)
  isRead        Boolean          @default(false) @map("is_read")
  trafficJobId  String?          @map("traffic_job_id")
  metadata      Json?
  createdAt     DateTime         @default(now()) @map("created_at")

  user          User             @relation(fields: [userId], references: [id])
  trafficJob    TrafficJob?      @relation(fields: [trafficJobId], references: [id])

  @@index([userId])
  @@map("user_notifications")
}

// ─────────────────────────────────────────────
// NO-SHOW EVIDENCE
// ─────────────────────────────────────────────

model NoShowEvidence {
  id             String   @id @default(uuid())
  trafficJobId   String   @map("traffic_job_id")
  imageUrls      String[] @map("image_urls")
  gpsLatitude    Decimal  @map("gps_latitude") @db.Decimal(10, 7)
  gpsLongitude   Decimal  @map("gps_longitude") @db.Decimal(10, 7)
  gpsMapLink     String   @map("gps_map_link")
  submittedBy    String   @map("submitted_by")
  submittedById  String   @map("submitted_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  trafficJob     TrafficJob @relation(fields: [trafficJobId], references: [id])

  @@unique([trafficJobId, submittedBy])
  @@map("no_show_evidence")
}

// ─────────────────────────────────────────────
// DEVICE TOKENS (FCM push notifications)
// ─────────────────────────────────────────────

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String
  platform  String   // 'ios' | 'android'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("device_tokens")
}

// ─────────────────────────────────────────────
// WEBSITE SETTINGS (B2C CMS - singleton)
// ─────────────────────────────────────────────

model WebsiteSettings {
  id                 String   @id @default(uuid())

  // ── Site Identity ──
  siteName           String   @default("iTour Transfers") @map("site_name")
  siteLogoUrl        String?  @map("site_logo_url")
  siteFaviconUrl     String?  @map("site_favicon_url")

  // ── Typography ──
  fontFamily         String   @default("Inter") @map("font_family")

  // ── Color Theme ──
  primaryColor       String   @default("#3b82f6") @map("primary_color")
  accentColor        String   @default("#8b5cf6") @map("accent_color")
  heroGradientFrom   String   @default("#1a1a2e") @map("hero_gradient_from")
  heroGradientTo     String   @default("#0f3460") @map("hero_gradient_to")
  navBgColor         String   @default("#1a1a2e") @map("nav_bg_color")
  footerBgColor      String   @default("#1a1a2e") @map("footer_bg_color")

  // ── Header/Footer Presets ──
  headerPreset       String   @default("default") @map("header_preset")
  footerPreset       String   @default("default") @map("footer_preset")

  // ── Hero Section Content ──
  heroTitle          String   @default("Book Your Airport Transfer") @map("hero_title")
  heroSubtitle       String   @default("Safe, comfortable, and reliable private transfers across Egypt.") @map("hero_subtitle")
  heroCta1Text       String   @default("Book Now") @map("hero_cta1_text")
  heroCta2Text       String   @default("Track a Booking") @map("hero_cta2_text")
  heroImageUrl       String?  @map("hero_image_url")

  // ── Features Section ──
  featuresEnabled    Boolean  @default(true) @map("features_enabled")
  featuresTitle      String   @default("Why Choose Us?") @map("features_title")
  featuresJson       Json?    @map("features_json")

  // ── Contact Info ──
  contactEmail       String?  @map("contact_email")
  contactPhone       String?  @map("contact_phone")
  contactWhatsapp    String?  @map("contact_whatsapp")
  socialFacebook     String?  @map("social_facebook")
  socialInstagram    String?  @map("social_instagram")
  socialTwitter      String?  @map("social_twitter")

  // ── Bank Payment ──
  bankPaymentEnabled Boolean  @default(false) @map("bank_payment_enabled")
  bankPaymentMessage String   @default("Bank payment integration coming soon!") @map("bank_payment_message")

  // ── SEO ──
  metaTitle          String?  @map("meta_title")
  metaDescription    String?  @map("meta_description")

  // ── Menu Links ──
  navLinksJson       Json?    @map("nav_links_json")

  // ── Audit ──
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("website_settings")
}
