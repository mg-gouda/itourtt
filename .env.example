# iTour Transport & Traffic – Environment Variables
# Copy this file to .env and fill in your values

# ── Domain ──
DOMAIN=yourdomain.com

# ── Database ──
POSTGRES_USER=itour
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=itour_db

# ── JWT (generate with: openssl rand -base64 64) ──
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ── App ──
NODE_ENV=production
TZ=Africa/Cairo

# ── Gemini (B2C auto-translate + AI parser) ──
# Get a key at https://aistudio.google.com/apikey — do NOT commit a real key.
GEMINI_API_KEY=

# ── GetPayIn (Paylink) payment gateway ──
# Created in GetPayIn dashboard: Settings → Payment Integrations → Add Integration.
# AUTH token is public-ish (sent in requests); HASH token is SECRET (signs/verifies).
GETPAYIN_BASE_URL=https://pay.getpayin.com
GETPAYIN_AUTH_TOKEN=
GETPAYIN_HASH_TOKEN=
# Public customer-facing site the payment redirect returns guests to.
B2C_SITE_URL=https://transfera.ae
